spec_version = 1
id = "KittenRemoteControl"
type = "mod"
name = "Kitten Remote Control"
authors = ["Attila Strba"]
abstract = "HTTP spacecraft controls, Telemachus-compatible telemetry and a Houston browser dashboard."
description = """
Experimental HTTP remote control and live telemetry for Kitten Space Agency.
Includes REST endpoints on port 8080, a Telemachus-compatible datalink on port 8085,
an in-game client connection window, and the Houston browser dashboard.
For Houston, run frontend/start-houston.cmd and visit http://localhost:8000/houston.html.
Python 3 is required only for the optional dashboard HTTP server.
Servers bind to the LAN without authentication or TLS; use a trusted network.
Tested on Windows. Wine/CrossOver support from the source branch is not retested for this prerelease.
"""
license = "MIT"
tags = ["tools", "user-interface"]

[releases]
github = "attilastrba/KittenRemoteControl"
tag_prefix = "v"
since = "0.1.0-borea.1"

