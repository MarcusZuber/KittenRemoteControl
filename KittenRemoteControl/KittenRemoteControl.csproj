<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-borea.2</Version>
    <Authors>Attila Strba</Authors>
    <Description>HTTP remote control, Telemachus telemetry and Houston dashboard for Kitten Space Agency.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/attilastrba/KittenRemoteControl</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <KSA_DLLS_PATH Condition="'$(KSA_DLLS_PATH)' == ''">$(MSBuildProjectDirectory)\..\KSA_dlls</KSA_DLLS_PATH>
    <STARMAP_PATH Condition="'$(STARMAP_PATH)' == ''">$(LOCALAPPDATA)\Borea\Loaders\StarMap</STARMAP_PATH>
  </PropertyGroup>
  <ItemGroup>
    <GameAssembly Include="$(KSA_DLLS_PATH)\KSA.dll;$(KSA_DLLS_PATH)\Brutal.*.dll;$(KSA_DLLS_PATH)\Planet.*.dll" />
    <Reference Include="@(GameAssembly)"><Private>false</Private></Reference>
    <Reference Include="StarMap.API"><HintPath>$(STARMAP_PATH)\StarMap.API.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(STARMAP_PATH)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <None Update="mod.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateInstalledAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(KSA_DLLS_PATH)\KSA.dll')" Text="Set KSA_DLLS_PATH to the installed KSA directory." />
    <Error Condition="!Exists('$(STARMAP_PATH)\0Harmony.dll')" Text="The installed StarMap directory must contain 0Harmony.dll." />
    <Error Condition="!Exists('$(STARMAP_PATH)\StarMap.API.dll')" Text="Set STARMAP_PATH to the installed StarMap directory." />
  </Target>
</Project>
